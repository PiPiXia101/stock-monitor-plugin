{
  "_comment": "异常响应集合。来源：Agent 构造（依据函数契约的异常约定：结构不符/字段缺失/乱码均需容错不崩溃）。每个元素一条异常场景",
  "cases": [
    {
      "name": "结构不符（无 result 字段）",
      "payload": { "code": 404, "msg": "Not Found" }
    },
    {
      "name": "result 存在但 cmsArticleWebOld 非数组",
      "payload": { "code": 0, "result": { "cmsArticleWebOld": "not-an-array" } }
    },
    {
      "name": "cmsArticleWebOld 为 null",
      "payload": { "code": 0, "result": { "cmsArticleWebOld": null } }
    },
    {
      "name": "单条缺 title 与 url（应跳过该条，不崩溃）",
      "payload": { "code": 0, "result": { "cmsArticleWebOld": [
        { "date": "2026-08-16 09:00:00", "code": "202608163800000901", "content": "缺标题缺链接", "mediaName": "测试媒体" }
      ] } }
    },
    {
      "name": "条目为 null 混在数组里（应跳过，不崩溃）",
      "payload": { "code": 0, "result": { "cmsArticleWebOld": [
        null,
        { "date": "2026-08-16 09:00:00", "code": "202608163800000902", "title": "正常条目", "content": "正常", "mediaName": "测试媒体", "url": "http://example.com/a.html" }
      ] } }
    },
    {
      "name": "公告接口 data 缺失（应返回 [] 不崩溃）",
      "payload": { "error": "gateway timeout" }
    }
  ]
}
